# Copy to .env (ignored). Server-only Cloudflare bindings; never use VITE_ or NEXT_PUBLIC_.
# GLPI 9.5.4: classic REST API (apirest.php), not API V2.
GLPI_API_VERSION=v1
GLPI_BASE_URL=
# Optional only after the network team confirms a protected private route.
# Pin the exact RFC1918 IPv4 address in GLPI_BASE_URL.
GLPI_PRIVATE_HTTP_HOST=
# Explicit opt-in for unencrypted HTTP to one exact IPv4 address, including a public IP.
# Basic passwords and GLPI tokens will travel without TLS. Prefer HTTPS.
# Do not set this together with GLPI_PRIVATE_HTTP_HOST.
GLPI_HTTP_HOST=
# Optional for V1, required if your API client has an App Token configured.
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TIMEOUT_MS=10000
GLPI_TICKET_CREATE_TIMEOUT_MS=20000
# Optional one-time bootstrap allowlist. Set to the GLPI numeric user ID of the first Lastro admin.
# Keep unset until the administrator identity has been approved.
OPUSLOG_BOOTSTRAP_GLPI_USER_ID=
